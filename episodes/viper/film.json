 "sentences": [
  {
   "text": "The world's deadliest assassin took a contract to eliminate a ruthless king,",
   "words": [
    0,
    11
   ],
   "subject": "viper"
  },
  {
   "text": "and broke into the wrong palace... without his glasses.",
   "words": [
    12,
    20
   ],
   "subject": "viper"
  },
  {
   "text": "Half-blind, Viper dropped through a roof straight into a smoky room,",
   "words": [
    21,
    31
   ],
   "subject": "viper"
  },
  {
   "text": "mistaking the royal kitchen for the throne room.",
   "words": [
    32,
    39
   ],
   "subject": "viper"
  },
  {
   "text": "Before he could escape, the terrifying head chef cornered him with a giant cleaver.",
   "words": [
    40,
    53
   ],
   "subject": "chef"
  },
  {
   "text": "Thinking fast, Viper dipped a finger into a bubbling pot of mysterious green stew.",
   "words": [
    54,
    67
   ],
   "subject": "pot"
  },
  {
   "text": "Even though it tasted like boiled socks,",
   "words": [
    68,
    74
   ],
   "subject": "viper"
  },
  {
   "text": "he let out a dramatic gasp... and called it a masterpiece.",
   "words": [
    75,
    85
   ],
   "subject": "viper"
  },
  {
   "text": "Overwhelmed, the chef burst into tears of joy.",
   "words": [
    86,
    93
   ],
   "subject": "chef"
  },
  {
   "text": "Nobody had ever praised his cooking before.",
   "words": [
    94,
    100
   ],
   "subject": "chef"
  },
  {
   "text": "Even better, he invited Viper to help serve the king's private dinner.",
   "words": [
    101,
    112
   ],
   "subject": "viper"
  },
  {
   "text": "Royal guards checked every tray, completely ignoring the hooded assassin carrying a silver platter.",
   "words": [
    113,
    126
   ],
   "subject": "guard1"
  },
  {
   "text": "Viper reached the throne in seconds.",
   "words": [
    127,
    132
   ],
   "subject": "viper"
  },
  {
   "text": "His secret?",
   "words": [
    133,
    134
   ],
   "subject": "viper"
  },
  {
   "text": "He spent the next week recovering from food poisoning.",
   "words": [
    135,
    143
   ],
   "subject": "viper"
  }
 ],
